<%
// 这几个变量后面要用好几次，先算好：
//   pageIsPost  —— 当前是不是文章详情页（post.ejs 把 post 变量传下来了，EJS include 自动继承外层局部变量）
const pageIsPost = typeof post !== 'undefined' && post;
const ogImage = pageIsPost && post.cover_image ? post.cover_image : (siteUrl + '/img/og-default.png');
const resolvedTitle = typeof pageTitle === 'string' && pageTitle ? pageTitle : siteName;
const resolvedDescription = typeof pageDescription === 'string' && pageDescription ? pageDescription : siteDescription;
%>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof pageTitle === 'string' && pageTitle ? pageTitle + ' · ' + siteName : siteName %></title>
  <meta name="description" content="<%= resolvedDescription %>">
  <meta name="author" content="<%= siteAuthor %>">
  <link rel="canonical" href="<%= siteUrl %><%= currentPath %>">

  <meta property="og:site_name" content="<%= siteName %>">
  <meta property="og:title" content="<%= resolvedTitle %>">
  <meta property="og:description" content="<%= resolvedDescription %>">
  <meta property="og:type" content="<%= pageIsPost ? 'article' : 'website' %>">
  <meta property="og:url" content="<%= siteUrl %><%= currentPath %>">
  <meta property="og:image" content="<%= ogImage %>">
  <% if (pageIsPost) { %>
    <meta property="article:published_time" content="<%= new Date(post.published_at).toISOString() %>">
    <meta property="article:modified_time" content="<%= new Date(post.updated_at).toISOString() %>">
    <meta property="article:author" content="<%= siteAuthor %>">
  <% } %>

  <meta name="twitter:card" content="<%= (pageIsPost && post.cover_image) ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= resolvedTitle %>">
  <meta name="twitter:description" content="<%= resolvedDescription %>">
  <meta name="twitter:image" content="<%= ogImage %>">

  <% if (typeof totalPages !== 'undefined' && totalPages > 1 && typeof basePath !== 'undefined') { %>
    <% if (page > 1) { %><link rel="prev" href="<%= siteUrl %><%= basePath %><%= page - 1 > 1 ? '?page=' + (page - 1) : '' %>"><% } %>
    <% if (page < totalPages) { %><link rel="next" href="<%= siteUrl %><%= basePath %>?page=<%= page + 1 %>"><% } %>
  <% } %>

  <link rel="alternate" type="application/rss+xml" title="<%= siteName %>" href="/feed.xml">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link nonce="<%= cspNonce %>" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
  <% if (typeof notebookEnabled !== 'undefined' && notebookEnabled) { %>
    <%# 首页"翻书"视觉层专用字体（标题/日期用的艺术字），只在真正首页加载，
        不拖慢文章页/标签页——见 docs/BOOK_DESIGN.md 第1节"分层用字原则"。 %>
    <link nonce="<%= cspNonce %>" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/notebook.css?v=<%= assetVersion %>">
  <% } %>

  <% if (pageIsPost) { %>
  <script type="application/ld+json" nonce="<%= cspNonce %>">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.title,
    "description": post.seo_description || post.summary || siteDescription,
    "image": ogImage,
    "datePublished": new Date(post.published_at).toISOString(),
    "dateModified": new Date(post.updated_at).toISOString(),
    "author": { "@type": "Person", "name": siteAuthor },
    "publisher": { "@type": "Organization", "name": siteName },
    "mainEntityOfPage": { "@type": "WebPage", "@id": siteUrl + currentPath },
    "url": siteUrl + currentPath
  }) %>
  </script>
  <% } else { %>
  <script type="application/ld+json" nonce="<%= cspNonce %>">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": siteName,
    "description": siteDescription,
    "url": siteUrl + "/"
  }) %>
  </script>
  <% } %>
</head>
