<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof pageTitle === 'string' && pageTitle ? pageTitle + ' · ' + siteName : siteName %></title>
  <meta name="description" content="<%= typeof pageDescription === 'string' && pageDescription ? pageDescription : siteDescription %>">
  <link rel="canonical" href="<%= siteUrl %><%= currentPath %>">
  <meta property="og:site_name" content="<%= siteName %>">
  <meta property="og:title" content="<%= typeof pageTitle === 'string' && pageTitle ? pageTitle : siteName %>">
  <meta property="og:description" content="<%= typeof pageDescription === 'string' && pageDescription ? pageDescription : siteDescription %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary">
  <link rel="alternate" type="application/rss+xml" title="<%= siteName %>" href="/feed.xml">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link nonce="<%= cspNonce %>" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
