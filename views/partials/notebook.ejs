<%
// 首页"日记目录"视觉层——渐进增强，不是一套平行的内容系统。
// 真正的内容和链接就是 index.ejs 里那份 #plain-post-list：每个标题都是
// 真实的 <a href="/p/:slug">，无 JS / 搜索引擎爬虫看到的是同一份数据。
// 这里只是给桌面宽度、JS 可用时，换一层更像"翻开的日记本目录"的外观，
// 加上搜索/标签/季度筛选——列表条目本身还是真实链接，点击就是普通跳转，
// 没有翻页动效，也没有单独的"文章片段"接口（2026-09-23 起，历史见
// docs/HANDOFF.md v11：之前那版两页对开+3D翻页动效已经放弃）。
%>
<section id="notebook-book" class="nb-page post-card" hidden aria-label="文章目录">
  <header class="nb-page-head">
    <div class="nb-page-head-row">
      <h2 class="nb-page-title">目录</h2>
      <span id="nb-vol" class="nb-page-vol"></span>
    </div>
    <div class="nb-page-controls">
      <input id="nb-search" class="nb-search" type="search" placeholder="搜索文章…" autocomplete="off">
      <select id="nb-volume-select" class="nb-volume-select" aria-label="按季度筛选"></select>
    </div>
    <div id="nb-tags" class="nb-tags"></div>
  </header>

  <ol id="nb-entries" class="nb-entries"></ol>

  <p id="nb-empty" class="nb-empty" hidden>没有找到相关文章。</p>
  <p id="nb-error" class="nb-empty nb-error" hidden></p>

  <nav id="nb-pagination" class="pagination nb-pagination" hidden>
    <a href="#" id="nb-prev">&larr; 上一页</a>
    <span id="nb-page-no"></span>
    <a href="#" id="nb-next">下一页 &rarr;</a>
  </nav>
</section>

<script nonce="<%= cspNonce %>" src="/js/notebook.js?v=<%= assetVersion %>" defer></script>
