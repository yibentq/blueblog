<%
// 首页"日记目录"视觉层——渐进增强，不是一套平行的内容系统。
// 真正的内容和链接就是 index.ejs 里那份 #plain-post-list：每个标题都是
// 真实的 <a href="/p/:slug">，无 JS / 搜索引擎爬虫看到的是同一份数据。
// 这里只是给桌面宽度、JS 可用时，换一层更像"翻开的日记本目录"的外观，
// 加上搜索/标签/季度筛选——列表条目本身还是真实链接，点击就是普通跳转，
// 没有翻页动效，也没有单独的"文章片段"接口（2026-09-23 起，历史见
// docs/HANDOFF.md v11：之前那版两页对开+3D翻页动效已经放弃）。
%>
<section id="notebook-book" class="nb-page post-card" hidden aria-label="文章目录">
  <header class="nb-page-head">
    <div class="nb-page-head-row">
      <h2 class="nb-page-title">目录</h2>
      <span id="nb-vol" class="nb-page-vol"></span>
    </div>
    <div class="nb-page-controls">
      <div class="nb-search-wrap">
        <svg class="nb-search-icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
          <circle cx="6" cy="6" r="4.6" fill="none" stroke="currentColor" stroke-width="1.3"/>
          <path d="M9.6 9.6 13 13" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
        <input id="nb-search" class="nb-search" type="search" placeholder="搜索文章…" autocomplete="off">
      </div>
      <div id="nb-volume-select" class="nb-select">
        <button type="button" id="nb-volume-trigger" class="nb-select-trigger"
                aria-haspopup="listbox" aria-expanded="false" aria-label="按季度筛选">
          <span id="nb-volume-value" class="nb-select-value">加载中…</span>
          <svg class="nb-select-caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
            <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul id="nb-volume-menu" class="nb-select-menu" role="listbox" tabindex="-1" hidden></ul>
      </div>
    </div>
    <div id="nb-tags" class="nb-tags"></div>
  </header>

  <ol id="nb-entries" class="nb-entries"></ol>

  <p id="nb-empty" class="nb-empty" hidden>没有找到相关文章。</p>
  <p id="nb-error" class="nb-empty nb-error" hidden></p>

  <%
  // 翻页箭头用跟 index.ejs 那份服务端分页同一个 paginationArrow()（brand.js 里
  // rosette() 派生的指针图形），之前这里是漏网的 &larr;/&rarr; 字符实体——同一个
  //概念在两处一个已经是签名同源的原创图形、一个还是零设计的默认写法，是本轮盘点
  // 才发现的不一致（docs/HANDOFF.md v27）。这里翻上/翻下是 JS 切一个 .disabled
  // class（见 notebook.js），不是像 index.ejs 那样服务端直接输出两种不同透明度的
  // SVG，所以透明度改由 CSS 在 .disabled 状态整体调（notebook.css）。
  %>
  <nav id="nb-pagination" class="pagination nb-pagination" hidden>
    <a href="#" id="nb-prev"><%- paginationArrow('prev') %> 上一页</a>
    <span id="nb-page-no"></span>
    <a href="#" id="nb-next">下一页 <%- paginationArrow('next') %></a>
  </nav>
</section>

<script nonce="<%= cspNonce %>" src="/js/notebook.js?v=<%= assetVersion %>" defer></script>
