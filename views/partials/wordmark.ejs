<%
// blog.blue 专属词标（wordmark）。
// 设计说明：句号位置换成罗盘/坐标标记（呼应蓝图主题），".blue" 用斜体烫金色区分域名后缀，
// 底下一条细尺子线首尾各一个短刻度，像图纸上量出来的一段真实尺寸，而不是随手画的下划线。
// 内联在页面里而不是用 <img> 引用，是为了让它能直接继承页面已加载的 Fraunces 字体。
%>
<svg class="wordmark" width="<%= typeof wordmarkWidth !== 'undefined' ? wordmarkWidth : 176 %>" height="<%= typeof wordmarkHeight !== 'undefined' ? wordmarkHeight : 47 %>" viewBox="0 0 330 88" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="blog.blue">
  <text x="0" y="52" class="wordmark-blog" font-weight="700" font-size="46" letter-spacing="-0.5">blog</text>
  <g class="wordmark-mark" transform="translate(122,35)">
    <circle cx="0" cy="0" r="7" fill="none" stroke-width="1.6"/>
    <circle cx="0" cy="0" r="1.6"/>
    <line x1="-11" y1="0" x2="-9" y2="0" stroke-width="1.2"/>
    <line x1="9" y1="0" x2="11" y2="0" stroke-width="1.2"/>
    <line x1="0" y1="-11" x2="0" y2="-9" stroke-width="1.2"/>
    <line x1="0" y1="9" x2="0" y2="11" stroke-width="1.2"/>
  </g>
  <text x="145" y="52" class="wordmark-blue" font-weight="400" font-style="italic" font-size="46" letter-spacing="-0.5">blue</text>
  <line x1="2" y1="70" x2="292" y2="70" class="wordmark-rule" stroke-width="1"/>
  <line x1="2" y1="66" x2="2" y2="70" class="wordmark-tick" stroke-width="1.5"/>
  <line x1="292" y1="66" x2="292" y2="70" class="wordmark-tick" stroke-width="1.5"/>
</svg>
