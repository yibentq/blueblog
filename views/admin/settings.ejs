<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>设置 · blog.blue 后台</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-shell">
    <%- include('../partials/admin-nav') %>
    <div class="admin-main">
      <h1>设置</h1>

      <% if (typeof error !== 'undefined' && error) { %><p class="error-msg"><%= error %></p><% } %>

      <form method="post" action="/admin/settings" style="max-width:420px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field inline">
          <input type="checkbox" id="comments_enabled" name="comments_enabled" <%= settings.comments_enabled === 'true' ? 'checked' : '' %>>
          <label for="comments_enabled" style="margin:0">开启评论功能</label>
        </div>
        <div class="field">
          <label for="posts_per_page">每页文章数</label>
          <input id="posts_per_page" type="text" name="posts_per_page" value="<%= settings.posts_per_page || 10 %>">
        </div>
        <button class="btn" type="submit">保存设置</button>
      </form>

      <h1 style="margin-top:2.5rem">修改密码</h1>
      <form method="post" action="/admin/settings/password" style="max-width:420px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="current_password">当前密码</label>
          <input id="current_password" type="password" name="current_password" required autocomplete="current-password">
        </div>
        <div class="field">
          <label for="new_password">新密码（至少 10 位）</label>
          <input id="new_password" type="password" name="new_password" required minlength="10" autocomplete="new-password">
        </div>
        <button class="btn" type="submit">更新密码</button>
      </form>
    </div>
  </div>
</body>
</html>
