<!DOCTYPE html>
<html lang="zh-CN">
<%- include('partials/head') %>
<body>
  <%- include('partials/header') %>
  <main>
    <% if (tagName) { %>
      <div class="page-heading">
        <h1>标签：<%= tagName %></h1>
        <p><a href="/">&larr; 返回全部文章</a></p>
      </div>
    <% } %>

    <%
    // 首页"日记目录"视觉层是渐进增强：下面这份 #plain-post-list 永远原样服务端渲染，
    // 是无 JS 环境/搜索引擎爬虫看到的兜底，语义化结构（真实 <a href>、h2 标题层级）
    // 完全不变。只有 notebookEnabled 为真时才会输出 #notebook-book 容器；它默认
    // hidden，只有 public/js/notebook.js 检测到桌面宽度 + JS 可用时才会现身并隐藏掉
    // 这份卡片列表——移动端、无 JS、爬虫三种情况下都只会看到下面这份列表。
    %>
    <div id="plain-post-list">
      <% if (posts.length === 0) { %>
        <p class="empty-hint">这里还没有文章。</p>
      <% } %>

      <% posts.forEach(function(post) { %>
        <article class="post-card <%= post.is_pinned ? 'pinned' : '' %>">
          <% if (post.is_pinned) { %><p class="pinned-label">置顶</p><% } %>
          <h2><a href="/p/<%= post.slug %>"><%= post.title %></a></h2>
          <% if (post.summary) { %><p class="summary"><%= post.summary %></p><% } %>
          <div class="post-meta">
            <span><%= new Date(post.published_at).toISOString().slice(0,10).replace(/-/g, '.') %></span>
            <span><%= post.reading_minutes %> 分钟阅读</span>
            <span><%= post.view_count %> 次浏览</span>
          </div>
        </article>
      <% }) %>

      <% if (totalPages > 1) { %>
        <div class="pagination">
          <% if (page > 1) { %>
            <a href="<%= basePath %>?page=<%= page - 1 %>">&larr; 上一页</a>
          <% } else { %><span class="disabled">&larr; 上一页</span><% } %>
          <span>第 <%= page %> / <%= totalPages %> 页</span>
          <% if (page < totalPages) { %>
            <a href="<%= basePath %>?page=<%= page + 1 %>">下一页 &rarr;</a>
          <% } else { %><span class="disabled">下一页 &rarr;</span><% } %>
        </div>
      <% } %>
    </div>

    <% if (notebookEnabled) { %>
      <%- include('partials/notebook') %>
    <% } %>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
