<!DOCTYPE html>
<html lang="zh-CN">
<%- include('partials/head') %>
<body>
  <%- include('partials/header') %>
  <main>
    <article class="post-article">
      <header class="article-head">
        <h1><%= post.title %></h1>
        <div class="article-meta">
          <span><%= new Date(post.published_at).toISOString().slice(0,10).replace(/-/g, '.') %></span>
          <span><%= post.reading_minutes %> 分钟阅读</span>
          <span><%= post.view_count %> 次浏览</span>
        </div>
      </header>
      <% if (toc.length) { %>
        <%
        // 目录用的还是首页目录同一套"标题…省略号…定位"的排版语言（.nb-entry-dots 那条
        // 点线），不是另发明一套目录样式——同一个"目录"概念，只是这里指向的是页内锚点，
        // 不是文章链接。h3 缩进一级表示层级，锚点 id 是 renderMarkdown 生成时已经写进
        // content_html 的那份，这里只是摘出来重新排一遍，不会跟正文的锚点错位。
        %>
        <nav class="article-toc" aria-label="文章目录">
          <p class="article-toc-title">目录</p>
          <ol>
            <% toc.forEach(function(item) { %>
              <li class="toc-h<%= item.level %>">
                <a href="#<%= item.id %>">
                  <span class="toc-label"><%= item.text %></span>
                  <span class="toc-dots" aria-hidden="true"></span>
                </a>
              </li>
            <% }) %>
          </ol>
        </nav>
      <% } %>
      <div class="article-body"><%- post.content_html %></div>
      <% if (tags.length) { %>
        <div class="article-tags">
          <% tags.forEach(function(t) { %><a href="/tag/<%= t.slug %>">#<%= t.name %></a><% }) %>
        </div>
      <% } %>
      <%# 文末盲压落款：同一份签名路径（brand.js），只是换成"压进皮里"的颜色 %>
      <div class="blind-stamp" aria-hidden="true"><%- signatureMark({ width: 118, ink: '#7A582A', accent: '#7A582A', stroke: 5 }) %></div>
    </article>

    <% if (commentsEnabled) { %>
      <section class="comments" id="comments">
        <h2><%= comments.length %> 条评论</h2>
        <% comments.forEach(function(c) { %>
          <div class="comment<%= c.depth ? ' reply' : '' %><%= c.is_author ? ' by-author' : '' %>" id="c-<%= c.id %>" data-comment-id="<%= c.id %>" data-author="<%= c.author_name %>">
            <p class="comment-meta"><%= c.author_name %><% if (c.is_author) { %> <span class="comment-author-badge">作者</span><% } %> / <%= new Date(c.created_at).toISOString().slice(0,10) %>
              <button type="button" class="comment-reply-btn" data-reply-to="<%= c.id %>" data-reply-name="<%= c.author_name %>">回复</button>
            </p>
            <p><%= c.content %></p>
          </div>
        <% }) %>

        <% if (typeof query !== 'undefined' && query.comment === 'pending') { %>
          <p class="notice">评论已提交，审核通过后会显示在这里。</p>
        <% } %>

        <!-- 读者回复读者：点评论上的"回复"，这个表单原地搬到那条评论下面，parent_id 跟着填上；
             服务端（src/routes/public.js、src/models/comment.js）本来就支持 parent_id，只是前台一直没有入口。 -->
        <form class="comment-form" id="comment-form" method="post" action="/p/<%= post.slug %>/comments">
          <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off">
          <input type="hidden" name="parent_id" id="comment-parent-id" value="">
          <p class="comment-replying-to" id="comment-replying-to" hidden>
            回复 <span id="comment-replying-name"></span>
            <button type="button" id="comment-reply-cancel">取消</button>
          </p>
          <input type="text" name="author_name" placeholder="昵称" required maxlength="80">
          <input type="email" name="author_email" placeholder="邮箱（可选，不会公开）" maxlength="255">
          <textarea name="content" id="comment-content" rows="4" placeholder="说点什么" required maxlength="2000"></textarea>
          <button class="btn" type="submit">发送评论</button>
        </form>
        <% if (comments.length) { %>
          <script nonce="<%= cspNonce %>" src="/js/comment-reply.js?v=<%= assetVersion %>" defer></script>
        <% } %>
      </section>
    <% } %>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
