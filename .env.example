# ===== 服务配置 =====
NODE_ENV=production
PORT=3000
SITE_URL=https://blog.blue

# ===== 数据库（PostgreSQL）=====
DATABASE_URL=postgres://blog_blue:changeme@127.0.0.1:5432/blog_blue

# ===== 安全密钥（务必用随机值替换，可用: openssl rand -hex 32）=====
SESSION_SECRET=changeme_use_openssl_rand_hex_32
CSRF_SECRET=changeme_use_openssl_rand_hex_32

# ===== 管理员账号（首次 seed 时创建，之后可在后台改密码）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_strong_password
ADMIN_EMAIL=you@blog.blue

# ===== 站点信息 =====
SITE_NAME=blog.blue
SITE_DESCRIPTION=一个只做一件事的博客
SITE_AUTHOR=AAAduo

# ===== 上传目录（本地存储，建议用 Nginx 直出或换成对象存储）=====
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# ===== Cloudflare（若在 Cloudflare 后面，用于正确解析真实 IP，做限流）=====
TRUST_PROXY=true
