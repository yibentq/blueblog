# ===== 服务配置 =====
NODE_ENV=production
PORT=3000
SITE_URL=https://blog.blue

# ===== 数据库（PostgreSQL）=====
DATABASE_URL=postgres://blog_blue:changeme@127.0.0.1:5432/blog_blue

# ===== 安全密钥（务必用随机值替换，可用: openssl rand -hex 32）=====
SESSION_SECRET=changeme_use_openssl_rand_hex_32
CSRF_SECRET=changeme_use_openssl_rand_hex_32

# ===== 管理员账号（首次 seed 时创建，之后可在后台改密码）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_strong_password
ADMIN_EMAIL=you@blog.blue

# ===== 站点信息 =====
SITE_NAME=blog.blue
SITE_DESCRIPTION=一个只做一件事的博客
SITE_AUTHOR=AAAduo
# 建站时间——用于首页/页脚的"建站已运行 X天"计时。改成你自己实际的建站日期即可，
# 格式 ISO 8601（YYYY-MM-DDTHH:mm:ssZ），不填就默认取"现在"（每次重启都会变成 0 天，不建议留空）
SITE_LAUNCH_DATE=2026-01-01T00:00:00Z

# ===== 图片水印 / 防伪 =====
# 水印里那串暗码的签名密钥：序列号 = HMAC-SHA256(WATERMARK_SECRET, 文件名)。
# 不填也能跑，但暗码会退化成任何人都能算出来的公共序列，防伪就只剩装饰意义了。
# 生成：openssl rand -hex 32
# 注意：改了它，之前已经发出去的图就对不上号了——除非确认泄露，否则不要动。
WATERMARK_SECRET=changeme_use_openssl_rand_hex_32
# 水印贴哪：southeast(默认) / southwest / northeast / northwest / center
# center 是盖章式，防裁剪最狠，但会压在画面主体上，自己权衡
WATERMARK_POSITION=southeast

# ===== 上传目录（本地存储，建议用 Nginx 直出或换成对象存储）=====
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# ===== Cloudflare（若在 Cloudflare 后面，用于正确解析真实 IP，做限流）=====
TRUST_PROXY=true
